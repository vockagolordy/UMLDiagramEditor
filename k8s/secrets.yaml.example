# Copy to secrets.local.yaml and fill in your credentials before applying.
apiVersion: v1
kind: Secret
metadata:
  name: db-secret
  namespace: app
type: Opaque
stringData:
  POSTGRES_USER: uml
  POSTGRES_PASSWORD: CHANGE_ME_DATABASE_PASSWORD
---
apiVersion: v1
kind: Secret
metadata:
  name: back-secret
  namespace: app
type: Opaque
stringData:
  AUTH__JWT_PRIVATE_KEY: CHANGE_ME_RANDOM_JWT_KEY
  RBAC__ADMIN_EMAIL: admin@example.com
  RBAC__ADMIN_PASSWORD: CHANGE_ME_ADMIN_PASSWORD
  SMTP__USERNAME: ""
  SMTP__PASSWORD: ""
